node_modules/
dist/
target/
# Sidecar congelado: se regenera con `pnpm build:sidecar`, no se commitea
binaries/
.venv/
__pycache__/
*.pyc
data/
# Almacén local de Events UI: vive en cada repo, no se versiona. La política de
# puertas sí: es la que revisa el repo y la que aplica el MCP, así que viaja con
# él. La negación va después de la exclusión y no puede ser `.EUI/` entera.
.EUI/*
!.EUI/protocolos.json
*.db
*.db-wal
*.db-shm
.python-version.bak
.DS_Store
.vite/
*.log

# Capturas de las corridas e2e (se generan al correr la batería)
e2e/resultados/
