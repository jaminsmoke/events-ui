{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Events UI",
  "version": "0.5.2",
  "identifier": "es.eventsui.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:15175",
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NkEzN0QwQ0UyNjgwOEMKUldTTWdDYk8wRGRxS0xMUTljUHdIN2tmTmNmVjdYTkxYdXN4RnZiWTRNNXZpY25PZWplcU5lTjkK",
      "endpoints": [
        "https://github.com/jaminsmoke/events-ui/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Events UI",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/events-core",
      "binaries/eui"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/path-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
