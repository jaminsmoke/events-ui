    "react-dom": "^19"
  },
  "devDependencies": {
    "@events-ui/config": "workspace:*",
    "@events-ui/ui": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vite": "^7"
  }
}
