_get", "parameters": [{"name": "limite", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 1000, "minimum": 1, "default": 200, "title": "Limite"}}, {"name": "nivel", "in": "query", "required": false, "schema": {"anyOf": [{"enum": ["info", "aviso", "error"], "type": "string"}, {"type": "null"}], "title": "Nivel"}}, {"name": "origen", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Origen"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/EntradaLog"}, "title": "Response Get Log Log Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/log/purgar": {"post": {"tags": ["log"], "summary": "Post Purgar Log", "description": "Aplica ya la retenci\u00f3n del registro (tambi\u00e9n pasa sola al escribir).", "operationId": "post_purgar_log_log_purgar_post", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegistroPurgado"}}}}}}}, "/proyecciones/repo": {"get": {"tags": ["f2"], "summary": "Get Proyeccion Repo", "description": "Primera proyecci\u00f3n: estado del repo con su identidad (rama/commit).", "operationId": "get_proyeccion_repo_proyecciones_repo_get", "parameters": [{"name": "repo", "in": "query", "required": true, "schema": {"type": "string", "description": "Carpeta del repo: ruta absoluta o nombre en el lab", "title": "Repo"}, "description": "Carpeta del repo: ruta absoluta o nombre en el lab"}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProyeccionRepo"}}}}, "400": {"description": "Petici\u00f3n inv\u00e1lida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorDetail"}}}}, "404": {"description": "No existe el repo o la idea", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorDetail"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"Connection": {"properties": {"id": {"type": "integer", "title": "Id"}, "parent_uid": {"type": "string", "title": "Parent Uid"}, "child_uid": {"type": "string", "title": "Child Uid"}, "kind": {"type": "string", "enum": ["child", "related", "supersedes"], "title": "Kind"}, "created_at": {"type": "string", "title": "Created At"}}, "type": "object", "required": ["id", "parent_uid", "child_uid", "kind", "created_at"], "title": "Connection", "description": "Un enlace entre dos ideas, tal como lo define la arquitectura.\n\nLas conexiones son inmutables (ADR 0002): no hay POST ni DELETE \u2014ni la UI\nni la API las crean o las borran\u2014. Solo se leen (`GET /connections`)."}, "EntradaLog": {"properties": {"id": {"type": "integer", "title": "Id"}, "ts": {"type": "string", "title": "Ts"}, "nivel": {"type": "string", "enum": ["info", "aviso", "error"], "title": "Nivel"}, "origen": {"type": "string", "title": "Origen"}, "mensaje": {"type": "string", "title": "Mensaje"}}, "type": "object", "required": ["id", "ts", "nivel", "origen", "mensaje"], "title": "EntradaLog", "description": "Una l\u00ednea del registro operativo (`GET /log`): de la app, no del repo."}, "ErrorDetail": {"properties": {"detail": {"type": "string", "title": "Detail"}}, "type": "object", "required": ["detail"], "title": "ErrorDetail", "description": "Lo que devuelven los exception handlers de abajo: `{\"detail\": ...}`.\n\nDeclarado a prop\u00f3sito: sin esto, el OpenAPI solo publicaba el 200 y el\n422 de validaci\u00f3n, y el cliente TS ten\u00eda que adivinar (con un cast) que\nel 400/404 trae `detail` como texto."}, "Evento": {"properties": {"id": {"type": "integer", "title": "Id"}, "ts"